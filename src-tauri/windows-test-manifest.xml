<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Applied post-link to Windows test executables only by GitHub Actions.

  Tauri/WebView2-linked tests require Common Controls v6 to start on current
  Windows runners. This must not be passed to the normal application linker:
  tauri_build already embeds the application manifest, and a second manifest
  input would fail with CVT1100 duplicate-resource errors.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    version="0.1.3.0"
    name="TFRobotClient.Test"
    type="win32"
  />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
