{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFRobot Client",
  "version": "0.1.3",
  "identifier": "com.tfrobot.client",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TFRobot Client",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A2C-SMCP Computer Management Client",
    "longDescription": "TFRobot Client provides a graphical interface for managing MCP servers and SMCP connections.",
    "copyright": "Copyright 2026 TFRobot Team",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMDZBOTVDQkFEQzQ3ODIKUldTQ1I5eTZYS2tHc0JZbDBONU5mSWliTTFXZUYwdlJUcTI5UWdOc2ZrOENFRHdaaTVTZVF6VDgK",
      "endpoints": [
        "https://github.com/A2C-SMCP/tfrobot-client/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": true
    }
  }
}
