+#[tokio::test]
+async fn experiment_delayed_begin_requires_caller_abort_before_state_exists() {
+    let (manager, bundle_id, state) =
+        authorization_code_manager(OAuthFixtureMode::Dynamic, false).await;
+    state
+        .metadata_response_delay_ms
+        .store(500, Ordering::SeqCst);
+    let manager = Arc::new(manager);
+    let task_manager = Arc::clone(&manager);
+    let task_bundle = bundle_id.clone();
+    let begin_task = tokio::spawn(async move {
+        task_manager
+            .begin_oauth(
+                &task_bundle,
+                OAuthBeginRequest {
+                    redirect_uri: "http://127.0.0.1:9876/callback".to_string(),
+                    required_scope: None,
+                },
+            )
+            .await
+    });
+
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while state.total_requests.load(Ordering::SeqCst) < 2 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("delayed protected-resource discovery must start");
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert!(
+        !begin_task.is_finished(),
+        "begin_oauth unexpectedly completed inside the cancellation budget"
+    );
+
+    // cancel_oauth cannot be called here: its public input requires the state which begin_oauth
+    // has not returned. The only bounded host operation is aborting the caller future.
+    begin_task.abort();
+    assert!(begin_task.await.unwrap_err().is_cancelled());
+    state
+        .metadata_response_delay_ms
+        .store(0, Ordering::SeqCst);
+    let status = tokio::time::timeout(Duration::from_millis(200), manager.oauth_status(&bundle_id))
+        .await
+        .expect("aborting begin must release the manager lifecycle lock")
+        .unwrap();
+    assert_eq!(status, OAuthStatus::Unauthorized);
+    println!(
+        "EXPERIMENT delayed_begin_requires_caller_abort=true cancel_api_has_no_state=true"
+    );
+    manager.close().await.unwrap();
+}
