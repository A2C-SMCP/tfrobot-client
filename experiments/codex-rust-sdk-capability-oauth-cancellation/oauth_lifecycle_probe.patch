+#[tokio::test]
+async fn experiment_cancel_waits_for_exchange_and_clear_deletes_step_up_credentials() {
+    let (manager, bundle_id, state) =
+        authorization_code_manager(OAuthFixtureMode::PreregisteredPublic, false).await;
+    authorize_manager(&manager, &bundle_id, &state, None).await;
+    assert!(matches!(
+        manager.oauth_status(&bundle_id).await.unwrap(),
+        OAuthStatus::Authorized { .. }
+    ));
+
+    state.token_response_delay_ms.store(500, Ordering::SeqCst);
+    let launch = manager
+        .begin_oauth(
+            &bundle_id,
+            OAuthBeginRequest {
+                redirect_uri: "http://127.0.0.1:9876/callback".to_string(),
+                required_scope: Some("tools.write".to_string()),
+            },
+        )
+        .await
+        .unwrap();
+    let manager = Arc::new(manager);
+    let complete_manager = Arc::clone(&manager);
+    let complete_bundle = bundle_id.clone();
+    let issuer = state.base_url.clone();
+    let callback_state = launch.state.clone();
+    let complete_task = tokio::spawn(async move {
+        complete_manager
+            .complete_oauth(
+                &complete_bundle,
+                OAuthCallback {
+                    code: "authorization-code".to_string(),
+                    state: callback_state,
+                    issuer: Some(issuer),
+                },
+            )
+            .await
+    });
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while state.token_requests.load(Ordering::SeqCst) < 2 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("step-up token exchange must start");
+
+    let cancel_manager = Arc::clone(&manager);
+    let cancel_bundle = bundle_id.clone();
+    let mut cancel_task = tokio::spawn(async move {
+        cancel_manager
+            .cancel_oauth(
+                &cancel_bundle,
+                OAuthCancellation {
+                    state: launch.state,
+                    issuer: None,
+                    reason: OAuthCancellationReason::Cancelled,
+                },
+            )
+            .await
+    });
+    let cancel_waited_for_exchange =
+        tokio::time::timeout(Duration::from_millis(100), &mut cancel_task)
+            .await
+            .is_err();
+    assert!(
+        cancel_waited_for_exchange,
+        "cancel_oauth unexpectedly preempted the in-flight token exchange"
+    );
+    let exchange_succeeded = complete_task.await.unwrap().is_ok();
+    let cancel_rejected_after_exchange = cancel_task.await.unwrap().is_err();
+    assert!(exchange_succeeded && cancel_rejected_after_exchange);
+    assert!(matches!(
+        manager.oauth_status(&bundle_id).await.unwrap(),
+        OAuthStatus::Authorized { .. }
+    ));
+
+    // This is the only compensation currently available to tfrobot-client after the exchange
+    // wins. It clears the newly committed token and cannot restore the pre-step-up credential.
+    manager.clear_oauth(&bundle_id).await.unwrap();
+    let clear_deleted_credentials =
+        manager.oauth_status(&bundle_id).await.unwrap() == OAuthStatus::Unauthorized;
+    assert!(clear_deleted_credentials);
+    println!(
+        "EXPERIMENT cancel_waited_for_exchange={cancel_waited_for_exchange} \
+exchange_won_cancel_race={} clear_deleted_credentials={clear_deleted_credentials}",
+        exchange_succeeded && cancel_rejected_after_exchange
+    );
+    manager.close().await.unwrap();
+}
