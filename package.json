{
  "name": "tfrobot-client",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "runtime:prepare:tfbash": "node scripts/prepare-tfbash-runtime.mjs",
    "runtime:verify:tfbash": "node scripts/prepare-tfbash-runtime.mjs --verify",
    "tauri:dev:signed": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target-signed-dev\" CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER=\"$PWD/scripts/tauri-dev-sign-runner.sh\" CARGO_TARGET_X86_64_APPLE_DARWIN_RUNNER=\"$PWD/scripts/tauri-dev-sign-runner.sh\" tauri dev",
    "tauri": "tauri",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:rust": "cargo nextest run --manifest-path src-tauri/Cargo.toml",
    "test:rust:lib": "cargo nextest run --manifest-path src-tauri/Cargo.toml --lib",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:bench": "cargo bench --manifest-path src-tauri/Cargo.toml --bench benchmarks",
    "test:smoke": "cd e2e/smoke && wdio run wdio.config.ts",
    "test:all": "pnpm test:coverage && pnpm test:rust && pnpm test:e2e",
    "lint": "pnpm lint:ts && pnpm lint:eslint && pnpm lint:rust",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:fix": "eslint . --fix",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@turingfocus/chat-kit": "0.7.0",
    "@turingfocus/tfrs-auth": "0.2.0",
    "antd": "^5.23.4",
    "dayjs": "^1.11.19",
    "i18next": "^24.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@turingfocus/chat-gateway-tfrobot": "0.7.0",
      "@turingfocus/chat-protocol": "0.7.0",
      "@turingfocus/chat-react": "0.7.0",
      "@turingfocus/chat-runtime": "0.7.0",
      "@turingfocus/chat-ui-antd": "0.7.0"
    }
  },
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab"
}
